# EURES beta - Server configuration

# Default API key used to read/write the EURES beta Grist document.
GRIST_API_KEY=your-api-key-here

# Optional if you use the default public instance.
# GRIST_BASE_URL=https://grist.numerique.gouv.fr

# Shared EURES beta Grist document.
GRIST_DOC_EURES_BETA=your-grist-doc-id

# Dedicated tables for each flow.
GRIST_TABLE_EURES_BETA_CANDIDATE=Candidats
GRIST_TABLE_EURES_BETA_EMPLOYER=Besoins_Employeurs

# Optional monthly stats table displayed on /forms/eures-beta/stat
GRIST_TABLE_EURES_BETA_STATS=Pilotage_EURES_Mensuel

# Dedicated admin credentials for /admin/eures-beta/
ADMIN_USERNAME_EURES_BETA=eures-admin
ADMIN_PASSWORD_EURES_BETA=change-me

# Optional, defaults to eures-beta in this dedicated project.
APP_MODE=eures-beta
